{
  "$comment": "Bundled reasoning-model catalog. Used when a provider's model list does not say whether a model reasons. First matching rule wins; `match` is a case-insensitive regex on the model id. Update this file as new models ship.",
  "version": 3,
  "rules": [
    { "match": "qwen3[^/]*(coder|instruct-2507)", "reasoning": false, "note": "Qwen3 Coder / Instruct-2507 are non-thinking" },
    { "match": "(^|/)(gpt-oss)", "reasoning": true, "effort": { "type": "levels", "levels": ["low", "medium", "high"], "default": "medium" }, "tools": true },
    { "match": "(^|/)(o1|o3|o4)(-|$)", "reasoning": true, "effort": { "type": "levels", "levels": ["low", "medium", "high"], "default": "medium" }, "vision": true, "tools": true },
    { "match": "(^|/)gpt-5[^/]*(chat|instant)", "reasoning": false, "note": "chat-tuned GPT-5 variants do not take reasoning effort" },
    { "match": "(^|/)gpt-5", "reasoning": true, "effort": { "type": "levels", "levels": ["low", "medium", "high"], "default": "medium" }, "vision": true, "tools": true },
    { "match": "(^|/)gpt-6", "reasoning": true, "effort": { "type": "levels", "levels": ["low", "medium", "high"], "default": "medium" }, "vision": true, "tools": true },
    { "match": "claude-(3-7|3\\.7)-sonnet|claude-(sonnet|opus)-4-[015]|claude-(opus|sonnet)-4($|-\\d{8})|claude-haiku-4-5", "reasoning": true, "effort": { "type": "budget", "min": 1024, "max": 32000, "default": 8000 }, "vision": true, "tools": true },
    { "match": "claude-(opus|sonnet|haiku|fable|mythos)-[4-9]", "reasoning": true, "effort": { "type": "levels", "levels": ["low", "medium", "high", "xhigh", "max"], "default": "high" }, "vision": true, "tools": true },
    { "match": "gemini-2\\.5", "reasoning": true, "effort": { "type": "budget", "min": 128, "max": 32768, "default": 8192 }, "vision": true, "tools": true },
    { "match": "gemini-([3-9]|exp)", "reasoning": true, "effort": { "type": "levels", "levels": ["low", "high"], "default": "high" }, "vision": true, "tools": true },
    { "match": "grok-3-mini", "reasoning": true, "effort": { "type": "levels", "levels": ["low", "high"], "default": "low" }, "tools": true },
    { "match": "grok-[4-9][^/]*non-reasoning", "reasoning": false },
    { "match": "grok-[4-9]", "reasoning": true, "effort": { "type": "none" }, "vision": true, "tools": true },
    { "match": "magistral", "reasoning": true, "effort": { "type": "none" }, "tools": true },
    { "match": "deepseek-reasoner|deepseek-r1|r1-distill", "reasoning": true, "effort": { "type": "none" }, "tools": true },
    { "match": "deepseek-v3\\.[1-9]|deepseek-v[4-9]", "reasoning": true, "effort": { "type": "toggle" }, "tools": true },
    { "match": "qwq|qwen3|qwen-3|qwen3\\.5", "reasoning": true, "effort": { "type": "toggle" }, "tools": true },
    { "match": "kimi-k2[^/]*thinking|kimi-k[3-9]", "reasoning": true, "effort": { "type": "none" }, "tools": true },
    { "match": "glm-4\\.[5-9]|glm-[5-9]", "reasoning": true, "effort": { "type": "toggle" }, "tools": true },
    { "match": "minimax-m[1-9]", "reasoning": true, "effort": { "type": "none" }, "tools": true },
    { "match": "phi-4[^/]*reasoning|phi4-reasoning|phi4-mini-reasoning", "reasoning": true, "effort": { "type": "none" } },
    { "match": "exaone-deep|cogito|openthinker|deepscaler|smallthinker|skywork-or1|hermes-4|seed-oss|ernie[^/]*thinking|nemotron[^/]*(reason|nano|super|ultra)|granite[^/]*(thinking|reason)|apriel[^/]*thinker|lfm2[^/]*thinking|olmo[^/]*think", "reasoning": true, "effort": { "type": "toggle" } },
    { "match": "(thinking|reasoner|reasoning)", "reasoning": true, "effort": { "type": "none" } }
  ],
  "imageModels": [
    { "match": "gpt-image|dall-e", "note": "OpenAI Images API" },
    { "match": "imagen|gemini[^/]*image", "note": "Gemini image generation" },
    { "match": "flux|stable-diffusion|sdxl|seedream|ideogram|recraft|image", "note": "OpenRouter / OpenAI-compatible image-output models" }
  ]
}
