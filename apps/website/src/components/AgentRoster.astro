---
import { AGENTS } from "../lib/site";
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5" data-stagger>
  {
    AGENTS.map((a) => (
      <li class="glass transition-ui rounded-lg p-4 hover:-translate-y-0.5 hover:border-line-strong" data-stagger-item>
        <div class="mb-3 flex items-center gap-3">
          <span
            class="grid size-10 place-items-center rounded-full text-sm font-bold text-white shadow-md"
            style={`background:linear-gradient(135deg,${a.from},${a.to})`}
            aria-hidden="true"
          >
            {a.name[0]}
          </span>
          <div class="leading-tight">
            <p class="font-semibold text-fg">
              {a.name}
            </p>
            <p class="text-xs text-muted">{a.role}</p>
          </div>
        </div>
        <p class="text-sm text-muted">{a.job}</p>
      </li>
    ))
  }
</ul>
