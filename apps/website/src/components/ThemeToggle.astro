---
// Cycles system -> light -> dark. The first paint is handled by the inline script in BaseLayout.
---

<button
  type="button"
  id="theme-toggle"
  class="transition-ui grid size-10 place-items-center rounded-md border border-line text-muted hover:bg-hover hover:text-fg"
  aria-label="Theme: system. Click to change."
>
  <svg data-icon="system" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path>
  </svg>
  <svg data-icon="light" viewBox="0 0 24 24" class="hidden size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg data-icon="dark" viewBox="0 0 24 24" class="hidden size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  const ORDER = ["system", "light", "dark"] as const;
  type Theme = (typeof ORDER)[number];
  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle") as HTMLButtonElement;

  const current = (): Theme => {
    const t = root.getAttribute("data-theme");
    return ORDER.includes(t as Theme) ? (t as Theme) : "system";
  };
  const paint = () => {
    const t = current();
    btn.setAttribute("aria-label", `Theme: ${t}. Click to change.`);
    btn.querySelectorAll<SVGElement>("[data-icon]").forEach((el) => {
      el.classList.toggle("hidden", el.dataset.icon !== t);
    });
  };
  btn.addEventListener("click", () => {
    const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("dolphin-theme", next);
    } catch {
      /* storage unavailable: the choice just lasts for this page view */
    }
    paint();
  });
  paint();
</script>
