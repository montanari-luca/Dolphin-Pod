---
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { PUBLISHER, SITE } from "../lib/site";
import { loadManifest } from "../lib/manifest";

type Crumb = { name: string; path: string };
interface Props {
  /** The full <title>, used as-is. Defaults to the home page title. */
  title?: string;
  description?: string;
  /** Page-specific Open Graph type. */
  type?: "website" | "article";
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /** Trail after Home for the BreadcrumbList JSON-LD (subpages only). */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page, merged into the page's @graph. */
  schema?: Record<string, unknown>[];
}
const { title = SITE.seoTitle, description = SITE.seoDescription, type = "website", noindex = false, breadcrumbs, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const manifest = await loadManifest();
const ogImage = new URL("/og-image.png", Astro.site);
const home = new URL("/", Astro.site).href;

const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${home}#website`,
    url: home,
    name: SITE.name,
    description: SITE.seoDescription,
    inLanguage: "en",
    publisher: PUBLISHER,
  },
  ...(breadcrumbs?.length
    ? [
        {
          "@type": "BreadcrumbList",
          itemListElement: [{ name: SITE.name, path: "/" }, ...breadcrumbs].map((c, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: c.name,
            item: new URL(c.path, Astro.site).href,
          })),
        },
      ]
    : []),
  ...schema,
];
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#0b1020" />
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Runs before first paint so there is no theme flash. Storage can throw (private mode), hence the try/catch. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        var t = "system";
        try {
          var s = localStorage.getItem("dolphin-theme");
          if (s === "light" || s === "dark" || s === "system") t = s;
        } catch (e) {}
        d.setAttribute("data-theme", t);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="fixed left-3 top-3 z-[100] -translate-y-20 rounded-md bg-surface-solid px-3 py-2 text-sm font-semibold text-fg shadow-lg focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script type="application/json" id="manifest-data" set:html={JSON.stringify(manifest)} />
    <script>
      import "../scripts/motion";
      import "../scripts/download";
    </script>
  </body>
</html>
