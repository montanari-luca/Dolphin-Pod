---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allDocs, routeFor, summaryOf, titleOf } from "../../lib/docs";

const { guides } = await allDocs();
---

<BaseLayout
  title="Dolphin Pod Guides: Set Up Local and Cloud AI Models"
  description="Step-by-step Dolphin Pod guides for connecting models: run local AI with Ollama or LM Studio, or use cloud reasoning models through OpenRouter."
  breadcrumbs={[{ name: "Guides", path: "/guides/" }]}
>
  <div class="container-page py-14 md:py-20">
    <p class="eyebrow mb-2" data-reveal>Guides</p>
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl" data-reveal data-reveal-delay="0.05">Set up your models.</h1>
    <ul class="mt-10 grid gap-4 md:grid-cols-2" data-stagger>
      {
        guides.map((g) => (
          <li data-stagger-item>
            <a href={routeFor(g)} class="glass transition-ui block h-full rounded-lg p-6 hover:-translate-y-0.5 hover:border-line-strong">
              <h2 class="text-lg font-semibold">{titleOf(g)}</h2>
              <p class="mt-2 text-sm text-muted">{summaryOf(g)}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-10 text-sm text-muted">Setting up your iPhone? See <a href="/docs/sync/" class="underline hover:text-ink">encrypted sync</a> and <a href="/docs/remote-control/" class="underline hover:text-ink">remote control</a>.</p>
  </div>
</BaseLayout>
